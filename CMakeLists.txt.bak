cmake_minimum_required(VERSION 3.16)
project(myapp C)

# --- Compiler settings ---
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)

# Default build type = Debug (like your default "all" target)
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Debug)
endif()

# Warnings, equivalent to -Wall -Wextra
add_compile_options(-Wall -Wextra)

# Debug flags (equivalent to "all: CFLAGS += -g -fno-omit-frame-pointer")
set(CMAKE_C_FLAGS_DEBUG "-g -O0 -fno-omit-frame-pointer")
# Release flags (equivalent to "release: CFLAGS += -O3")
set(CMAKE_C_FLAGS_RELEASE "-O3")

# --- Output location, equivalent to TARGET := build/myapp ---
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/build)

# --- Find dependencies via pkg-config, equivalent to $(shell pkg-config ...) ---
find_package(PkgConfig REQUIRED)
pkg_check_modules(SDL3 REQUIRED sdl3)
pkg_check_modules(YAML REQUIRED yaml-0.1)

# --- Source files, equivalent to $(wildcard src/*.c) minus jsoncParser.c ---
file(GLOB SRC CONFIGURE_DEPENDS "src/*.c")
list(REMOVE_ITEM SRC "${CMAKE_SOURCE_DIR}/src/jsoncParser.c")

# --- Target definition ---
add_executable(myapp ${SRC})

# Equivalent to -Iinclude (and the extra system include path)
target_include_directories(myapp PRIVATE
        include
        /usr/lib64/gcc/x86_64-pc-linux-gnu/16.1.1/include/
        ${SDL3_INCLUDE_DIRS}
        ${YAML_INCLUDE_DIRS}
)

# Equivalent to LIBS := ... -lSDL3_image -lSDL3_ttf -lSDL3_mixer -lm ...
target_link_libraries(myapp PRIVATE
        ${SDL3_LIBRARIES}
        SDL3_image
        SDL3_ttf
        SDL3_mixer
        m
        ${YAML_LIBRARIES}
)

target_link_directories(myapp PRIVATE ${SDL3_LIBRARY_DIRS} ${YAML_LIBRARY_DIRS})
target_compile_options(myapp PRIVATE ${SDL3_CFLAGS_OTHER} ${YAML_CFLAGS_OTHER})